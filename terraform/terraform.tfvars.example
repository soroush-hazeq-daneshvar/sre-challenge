project_name                = "sre-challenge"
environment                 = "production"
region                      = "us-east-1"
control_plane_instance_type = "t3.medium"
worker_instance_type        = "t3.large"
ssh_public_key_path         = "~/.ssh/id_rsa.pub"
node_count                  = 2

allowed_cidr_blocks = [
  "YOUR_IP/32"
]

tags = {
  Project     = "sre-challenge"
  ManagedBy   = "terraform"
  Environment = "production"
  Owner       = "sre-team"
}
